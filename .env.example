# 方式一：单个接口（最简，本地用 .env.local，Vercel 用项目环境变量）
VOD_API_BASE=https://your-own-cms.example.com/api.php/provide/vod/
VOD_API_NAME=我的影视库

# 方式二：多个接口可切换（把 sources.example.json 压成一行填进来）
# VOD_SOURCES_JSON=[{"id":"own-cms","name":"自有授权接口","base":"https://your-own-cms.example.com/api.php/provide/vod/","enabled":true}]

# 注意：VOD_SOURCES_JSON 与 VOD_API_BASE 同时存在时，优先使用 VOD_SOURCES_JSON。
